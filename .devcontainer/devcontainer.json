{
  "name": "Bat-Q Demo",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },

  // Install dependencies after the container is created
  "postCreateCommand": "pip3 install --upgrade pip && pip3 install -r requirements.txt",

  // Automatically start the Streamlit app when the container opens
  "postAttachCommand": "python3 -m streamlit run Home.py --server.headless true",

  // Forward and label ports for VS Code / GitHub Codespaces
  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "openBrowser"
    },
    "9997": {
      "label": "Batfish Main Port",
      "onAutoForward": "ignore"
    },
    "9996": {
      "label": "Batfish Additional Port",
      "onAutoForward": "ignore"
    }
  },

  "remoteUser": "vscode"
}
